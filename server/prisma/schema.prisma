generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  HOD
  FACULTY
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum AcademicYearStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum WorkloadStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  LOCKED
}

enum WorkloadCategoryType {
  TEACHING
  PRACTICAL_LAB
  EXAMINATION
  EVALUATION
  PROJECT_SEMINAR
  ADMINISTRATIVE
  MEETING
  RESEARCH
  OTHER
}

enum ReviewAction {
  SUBMITTED
  RETURNED
  APPROVED
  REOPENED
  LOCKED
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id             String      @id @default(cuid())
  clerkUserId    String      @unique
  email          String      @unique
  employeeNumber String?     @unique
  firstName      String
  lastName       String
  phone          String?
  designation    String?
  status         UserStatus  @default(ACTIVE)
  departmentId   String?
  targetHours    Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  department       Department?             @relation("DepartmentMembers", fields: [departmentId], references: [id])
  roles            UserRole[]
  headAssignments  DepartmentHeadAssignment[]
  workloadRecords  WorkloadRecord[]
  reviews          WorkloadReview[]
  notifications    Notification[]
  reportJobs       ReportJob[]
  evidenceFiles    EvidenceFile[]
  createdEntries   WorkloadEntry[]         @relation("EntryCreator")

  @@index([departmentId])
  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         User[]                    @relation("DepartmentMembers")
  headAssignments DepartmentHeadAssignment[]
  workloadRecords WorkloadRecord[]
  reportJobs      ReportJob[]
}

model DepartmentHeadAssignment {
  id           String    @id @default(cuid())
  departmentId String
  userId       String
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId, isActive])
}

model AcademicYear {
  id        String             @id @default(cuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(DRAFT)
  isCurrent Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  workloadRecords WorkloadRecord[]
  rules           WorkloadRule[]
  reportJobs      ReportJob[]
}

model WorkloadUnit {
  id           String  @id @default(cuid())
  name         String
  abbreviation String  @unique
  isActive     Boolean @default(true)

  entries WorkloadEntry[]
}

model WorkloadCategory {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  description      String?
  type             WorkloadCategoryType
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  entries WorkloadEntry[]
  rules   WorkloadRule[]
}

model WorkloadRule {
  id             String   @id @default(cuid())
  academicYearId String
  categoryId     String
  rate           Decimal  @db.Decimal(10, 2)
  formula        String?
  minimumValue   Decimal? @db.Decimal(10, 2)
  maximumValue   Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  category     WorkloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([academicYearId, categoryId])
}

model WorkloadRecord {
  id                   String         @id @default(cuid())
  userId               String
  departmentId         String
  academicYearId       String
  status               WorkloadStatus @default(DRAFT)
  targetHours          Decimal        @db.Decimal(10, 2)
  calculatedTotalHours Decimal        @default(0) @db.Decimal(10, 2)
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  entries      WorkloadEntry[]
  reviews      WorkloadReview[]

  @@unique([userId, academicYearId])
  @@index([departmentId, academicYearId])
}

model WorkloadEntry {
  id              String    @id @default(cuid())
  workloadRecordId String
  categoryId      String
  unitId          String
  createdById     String
  title           String
  description     String?
  quantity        Decimal   @db.Decimal(10, 2)
  rateApplied     Decimal   @db.Decimal(10, 2)
  calculatedHours Decimal   @db.Decimal(10, 2)
  activityDate    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workloadRecord WorkloadRecord   @relation(fields: [workloadRecordId], references: [id], onDelete: Cascade)
  category       WorkloadCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           WorkloadUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("EntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  monthly        MonthlyWorkload[]
  evidenceFiles  EvidenceFile[]

  @@index([workloadRecordId])
  @@index([categoryId])
}

model MonthlyWorkload {
  id              String   @id @default(cuid())
  workloadEntryId String
  month           Int
  quantity        Decimal  @db.Decimal(10, 2)
  calculatedHours Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workloadEntry WorkloadEntry @relation(fields: [workloadEntryId], references: [id], onDelete: Cascade)

  @@unique([workloadEntryId, month])
}

model WorkloadReview {
  id              String       @id @default(cuid())
  workloadRecordId String
  reviewerId      String
  action          ReviewAction
  comments        String?
  createdAt       DateTime     @default(now())

  workloadRecord WorkloadRecord @relation(fields: [workloadRecordId], references: [id], onDelete: Cascade)
  reviewer       User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([workloadRecordId, createdAt])
}

model EvidenceFile {
  id              String   @id @default(cuid())
  workloadEntryId String
  uploadedById    String
  fileName        String
  storageKey      String
  mimeType        String
  fileSize        Int
  createdAt       DateTime @default(now())

  workloadEntry WorkloadEntry @relation(fields: [workloadEntryId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ReportJob {
  id             String      @id @default(cuid())
  requestedById  String
  academicYearId String?
  departmentId   String?
  type           String
  format         ReportFormat
  status         ReportStatus @default(QUEUED)
  fileName       String?
  storageKey     String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  requestedBy  User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}
